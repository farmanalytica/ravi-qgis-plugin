     <property name="html">
      <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;h1 style=&quot; margin-top:20px; margin-bottom:12px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#2c3e50;&quot;&gt;Sentinel-1 SAR Analysis Workflow&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt; &lt;br /&gt;&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#2980b9;&quot;&gt;How it Works&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt; &lt;/span&gt;&lt;/h1&gt;
&lt;ol style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot; style=&quot; margin-top:12px; margin-bottom:0px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Define Area of Interest (AOI):&lt;/span&gt; Specify your study area. &lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Set Temporal Parameters:&lt;/span&gt; Define your start and end dates. Use &lt;span style=&quot; font-weight:600;&quot;&gt;Date Subset Selection&lt;/span&gt; if you only need specific months or seasons. &lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Configure Processing Settings:&lt;/span&gt; Select your parameters to tailor the data to your environment (see table below). &lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Execute &amp;amp; Analyze:&lt;/span&gt; Run the processing to generate an &lt;span style=&quot; font-weight:600;&quot;&gt;interactive chart&lt;/span&gt; of backscatter changes over time. &lt;/li&gt;
&lt;li style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot; style=&quot; margin-top:0px; margin-bottom:12px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-weight:600;&quot;&gt;Export:&lt;/span&gt; Load specific dates as layers in QGIS or perform a &lt;span style=&quot; font-weight:600;&quot;&gt;Batch Export&lt;/span&gt; as GeoTIFF rasters. &lt;/li&gt;&lt;/ol&gt;
&lt;h2 style=&quot; margin-top:30px; margin-bottom:12px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#2980b9;&quot;&gt;Settings Explained&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt; &lt;/span&gt;&lt;/h2&gt;
&lt;table border=&quot;0&quot; style=&quot; margin-top:20px; margin-bottom:20px; margin-left:37px; margin-right:37px; border-collapse:collapse;&quot; cellspacing=&quot;2&quot; cellpadding=&quot;0&quot; bgcolor=&quot;#ffffff&quot;&gt;&lt;thead&gt;
&lt;tr&gt;
&lt;td bgcolor=&quot;#f8f9fa&quot; style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#2c3e50; background-color:#f8f9fa;&quot;&gt;Setting&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td bgcolor=&quot;#f8f9fa&quot; style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#2c3e50; background-color:#f8f9fa;&quot;&gt;Explanation&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/thead&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Orbit Direction&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;Choose &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Ascending&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; or &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Descending&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;. Sticking to one direction ensures consistency, as radar viewing angles vary between orbits.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Polarization&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;VV&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; is ideal for water and urban detection; &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;VH&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; is highly sensitive to vegetation and biomass changes.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Output Format&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Decibels (dB)&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; is a logarithmic scale best for visualization. &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Linear&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; is the raw power ratio, preferred for advanced statistical modeling.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Border Noise Correction&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;Removes dark, &amp;quot;noisy&amp;quot; pixels at the edges of image swaths for cleaner mosaics.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Terrain Flattening&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;Corrects geometric distortions in hilly areas so backscatter reflects ground cover rather than topography.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt;Speckle Filtering&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;
&lt;td style=&quot; padding-left:12; padding-right:12; padding-top:12; padding-bottom:12; border-top:1px; border-right:1px; border-bottom:1px; border-left:1px; border-top-color:#dfe6e9; border-right-color:#dfe6e9; border-bottom-color:#dfe6e9; border-left-color:#dfe6e9; border-top-style:solid; border-right-style:solid; border-bottom-style:solid; border-left-style:solid;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;Reduces the &amp;quot;salt and pepper&amp;quot; graininess inherent in radar imagery to make features more identifiable.&lt;/span&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;p style=&quot; margin-top:20px; margin-bottom:20px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%; background-color:#f0f7fb;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; font-style:italic; color:#333333;&quot;&gt;Methodology Note:&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-style:italic; color:#333333;&quot;&gt; The pipeline follows the noise-reduction standards from &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; font-style:italic; color:#333333;&quot;&gt;Mullissa et al. (2021)&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-style:italic; color:#333333;&quot;&gt;, implemented via the &lt;/span&gt;&lt;span style=&quot; font-family:'monospace'; font-size:8pt; font-style:italic; color:#333333; background-color:#f4f4f4;&quot;&gt;ee_s1_ard&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-style:italic; color:#333333;&quot;&gt; package developed by &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; font-style:italic; color:#333333;&quot;&gt;Mateus Pinto da Silva&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-style:italic; color:#333333;&quot;&gt;. &lt;/span&gt;&lt;/p&gt;
&lt;h3 style=&quot; margin-top:14px; margin-bottom:12px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#34495e;&quot;&gt;Reference&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-weight:600; color:#333333;&quot;&gt; &lt;/span&gt;&lt;/h3&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:37px; margin-right:37px; -qt-block-indent:0; text-indent:0px; line-height:160%;&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt;Mullissa, A., et al. (2021). &lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; font-style:italic; color:#333333;&quot;&gt;Sentinel-1 SAR Backscatter Analysis Ready Data Preparation in Google Earth Engine.&lt;/span&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; Remote Sensing, 13(10), 1954. DOI: &lt;/span&gt;&lt;a href=&quot;https://doi.org/10.3390/rs13101954&quot;&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; text-decoration: underline; color:#0000ff;&quot;&gt;10.3390/rs13101954&lt;/span&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'-apple-system','BlinkMacSystemFont','Segoe UI','Roboto','Helvetica','Arial','sans-serif'; font-size:8pt; color:#333333;&quot;&gt; &lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
    </widget>
   </widget>
